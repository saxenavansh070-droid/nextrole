# ---------------------------------------------------------------
# Next Role environment variables
# Copy this file to `.env` in the project root, then fill in values.
# ---------------------------------------------------------------

# --- Server ---
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nextrole
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth (Google Cloud Console -> OAuth client ID, Web application)
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# xAI Grok API (https://console.x.ai) - optional, falls back to local matching when empty
GROK_API_KEY=
GROK_MODEL=grok-4-fast
GROK_API_URL=https://api.x.ai/v1/chat/completions

# --- Client (Vite only reads VITE_* variables) ---
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
